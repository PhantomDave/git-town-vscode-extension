{
  "name": "phantomdave-gittown-wrapper",
  "displayName": "git town wrapper",
  "description": "A Wrapper built around the git town git extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gittown-explorer",
          "title": "Git Town",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "gittown-explorer": [
        {
          "id": "gittown-view",
          "name": "Git Town"
        },
        {
          "id": "gittown-settings",
          "name": "Settings"
        }
      ]
    },
    "commands": [
      {
        "command": "phantomdave-gittown-wrapper.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "phantomdave-gittown-wrapper.sync",
        "title": "Git Town: Sync",
        "description": "Sync the current branch with upstream changes"
      },
      {
        "command": "phantomdave-gittown-wrapper.hack",
        "title": "Git Town: Hack",
        "description": "Create and checkout a new feature branch"
      },
      {
        "command": "phantomdave-gittown-wrapper.ship",
        "title": "Git Town: Ship",
        "description": "Merge and delete the current feature branch"
      },
      {
        "command": "phantomdave-gittown-wrapper.propose",
        "title": "Git Town: Propose",
        "description": "Create a pull request for the current branch"
      },
      {
        "command": "phantomdave-gittown-wrapper.initializeGitTown",
        "title": "Git Town: Initialize",
        "description": "Initialize Git Town for the current repository"
      }
    ],
    "keybindings": [
      {
        "command": "phantomdave-gittown-wrapper.hack",
        "key": "ctrl+k h",
        "mac": "cmd+k h",
        "when": "!editorTextFocus"
      },
      {
        "command": "phantomdave-gittown-wrapper.sync",
        "key": "ctrl+k s",
        "mac": "cmd+k s",
        "when": "!editorTextFocus"
      },
      {
        "command": "phantomdave-gittown-wrapper.propose",
        "key": "ctrl+k p",
        "mac": "cmd+k p",
        "when": "!editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "phantomdave-gittown-wrapper.refresh",
          "group": "navigation",
          "when": "view == gittown-view"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
